REPRICER_DB_PATH=dev.db
REPRICER_MODEL=claude-sonnet-5-5
REPRICER_EXTRACTOR=llm          # llm | regex
REPRICER_LLM_MODE=live          # live | record (call API + save cassette) | replay (cassette only)
